<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WpfPilot.Mcp.Server</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <PackageId>WpfPilot.Mcp.Server</PackageId>
    <Version>0.1.0</Version>
    <Authors>WpfPilot MCP Contributors</Authors>
    <Description>Local MCP server for inspecting, automating, and testing Windows WPF applications.</Description>
    <PackageTags>mcp;wpf;automation;testing;flaui</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfPilot.Mcp.Core\WpfPilot.Mcp.Core.csproj" />
    <ProjectReference Include="..\WpfPilot.Mcp.Codegen\WpfPilot.Mcp.Codegen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.1" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
